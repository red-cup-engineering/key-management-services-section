{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "key-management-services-section/mandate",
  "title": "Mandate",
  "description": "A bounded signing mandate, the shape sign-with-wallet.mjs checks a payload against: one chain, one signer address, an allowed contract set (EVM) or recipient set (Hive), a maximum amount in the chain's smallest unit, and an expiry.",
  "type": "object",
  "required": [
    "chain",
    "address",
    "maxAmountWei",
    "expiresAt"
  ],
  "oneOf": [
    {
      "required": [
        "allowedContracts"
      ]
    },
    {
      "required": [
        "allowedRecipients"
      ]
    }
  ],
  "properties": {
    "chain": {
      "enum": [
        "base",
        "ethereum",
        "arbitrum",
        "avalanche",
        "hive",
        "hive-engine"
      ]
    },
    "address": {
      "type": "string",
      "minLength": 1
    },
    "allowedContracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      }
    },
    "allowedRecipients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{2,15}$"
      }
    },
    "maxAmountWei": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "unsignedTransactionHash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "Optional exact unsigned EVM transaction digest, checked before signing."
    },
    "allowedTokenTransfers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "token",
          "maxAmountRaw",
          "recipients"
        ],
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "maxAmountRaw": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)$"
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
