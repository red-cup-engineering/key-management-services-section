    "@red-cup-engineering/witness-journal-document-service": "0.1.2",
    "@red-cup-engineering/hive-blockchain-client-service": "0.1.5"
  },
  "devDependencies": {
    "@red-cup-engineering/computer-system-engine": "0.1.2"
